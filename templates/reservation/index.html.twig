{% extends 'base.html.twig' %}

{% block title %}Reservation index{% endblock %}

{% block body %}
    <h1>Reservation index</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Cinema</th>
            <th>Film</th>
            <th>Seance</th>
            {# <th>Date</th> #}
            <th>NombrePlace</th>
            <th>PrixTotal</th>
            <th>QrCode</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.seance.cinema }}</td>
                <td>{{ reservation.seance.film }}</td>
                <td>{{ reservation.seance.heureDebut|date('H:i') }}.{{ reservation.seance.id }}</td>
                {#   <td>{{ reservation.seance.heureDebut }}</td> #}
                <td>{{ reservation.nombrePlace }}</td>
                <td>{{ reservation.prixTotal }}</td>
                <td>{{ reservation.qrCode }}</td>
                <td>{{ reservation.status.value }}</td>
                <td>
                    <a href="{{ path('app_reservation_show', {'id': reservation.id}) }}">show</a>
                    <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_reservation_new') }}">Create new</a>
{% endblock %}
