{# templates/components/form_base.html.twig #}
{# Ce partial définit la structure générale de vos formulaires #}
{% block form_base_start %}
<div class="form-container max-w-md mx-auto p-6 bg-white rounded-lg shadow">
    <h2 class="text-2xl font-semibold mb-4">{{ title|default('Formulaire') }}</h2>
    {{ form_start(form, {
        attr: {
            class: 'space-y-4'
        }
    }) }}
    {% endblock %}

    {% block form_base_fields %}
        {# Par défaut on affiche tous les champs #}
        {{ form_widget(form) }}
    {% endblock %}

    {% block form_base_actions %}
        <div class="form-actions flex justify-end space-x-2 mt-4">
            {% if backPath is defined %}
                <a href="{{ backPath }}" class="btn btn-secondary">Retour</a>
            {% endif %}
            <button type="submit"
                    class="btn btn-primary">{{ buttonLabel|default('Envoyer') }}</button>
        </div>
    {% endblock %}

    {% block form_base_end %}
    {{ form_end(form) }}
</div>
{% endblock %}
